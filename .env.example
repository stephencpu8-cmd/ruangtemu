# Alamat server sinyal. Kosong = otomatis ws://<host-halaman>:3001 (wss:// bila halaman HTTPS)
# VITE_SIGNALING_URL=wss://sinyal.contoh.id

# Server ICE (JSON). Default: STUN publik Google. Untuk jaringan ketat (NAT simetris) tambahkan TURN.
# PERHATIAN: nilai VITE_* terlihat oleh siapa pun di browser. Untuk produksi, gunakan kredensial TURN
# berumur pendek yang dibuat server, bukan password tetap.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
